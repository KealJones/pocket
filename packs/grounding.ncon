// Small grounded bootstrap. These are editable teaching materials, not host
// dispatch. English operation aliases are acquired from source senses on demand.
Concept(RequestLearningPolicy(),MaximumPasses(12),MaximumJobs(8),MaximumDecodings(64),MaximumMilliseconds(45000))
Concept(ExampleExpression(),IsA(ComputableExpression()),Surface("example expression"))
StarterLesson("what is example expression?",RequestValue(ExampleExpression()),weight=9)
StarterLesson("what is example expression",RequestValue(ExampleExpression()),weight=9)
StarterLesson("how much is example expression?",RequestValue(ExampleExpression()),weight=9)
StarterLesson("how much is example expression",RequestValue(ExampleExpression()),weight=9)

Concept(ScalarProduct(),IsA(ComputableExpression()),Surface("*"),
  SenseIdentity("Q40276",source=WikidataSource()),
  Frame(pattern=List(Slot($left,primitive="number"),Lexeme(ScalarProduct()),Slot($right,primitive="number")),meaning=ScalarProduct($left,$right)),
  ImplementationLesson(ScalarProduct($left,$right),language="javascript",code="(a,b) => a*b",
    checks=List(Check(ScalarProduct(7,6),42),Check(ScalarProduct(4,9),36))))
Concept(ScalarSum(),IsA(ComputableExpression()),Surface("+"),
